# Copiá este archivo a .env y completá los valores.
# .env está en .gitignore — nunca subas credenciales al repo.

# ---------------------------------------------------------------------------
# Base de datos — PostgreSQL 13+ (gen_random_uuid, TIMESTAMPTZ)
# ---------------------------------------------------------------------------

# Opción A — Postgres local (docker compose up -d)
DATABASE_URL=postgresql+asyncpg://dolce:dolce@localhost:5432/dolceamoremio

# Opción B — Supabase, "Session pooler" (recomendado para esta API)
#   Dashboard → Connect → Session pooler → URI
#   El usuario es postgres.<ref> y el host termina en .pooler.supabase.com
#   Ojo: ssl=require, no sslmode=require. asyncpg no entiende el segundo.
# DATABASE_URL=postgresql+asyncpg://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?ssl=require

# Opción C — Supabase, conexión directa (solo IPv6 salvo add-on de IPv4)
# DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.REF.supabase.co:5432/postgres?ssl=require

# Si la contraseña tiene @ : / ? # o %, hay que URL-encodearla
# (@ → %40, # → %23, / → %2F, : → %3A, ? → %3F, % → %25).

# Tamaño del pool. El límite de conexiones en Supabase es por proyecto, no por
# proceso: cada worker de uvicorn multiplica estos números.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=True

# ---------------------------------------------------------------------------
# CORS — origen del frontend
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Checkout
# ---------------------------------------------------------------------------
SHIPPING_COST=15000

# ---------------------------------------------------------------------------
# Endpoints de administración (cabecera X-Admin-Token).
# Sin este valor responden 503. Generá uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ---------------------------------------------------------------------------
# ADMIN_API_TOKEN=
